{% include "./list-validation-messages.njk" %}

     {% if validationErrors.fixSources|length %}
          {% if 'ADJUSTMENTS' in validationErrors.fixSources %}
               <li>
                   <p class="govuk-body govuk-!-margin-bottom-0">Update these details in the <a href="{{ adjustmentsUiUrl }}/{{ model.prisonerDetail.offenderNo }}">Adjustments tab</a>.
                   </p>
               </li>
          {% endif %}

          {% if 'ADJUDICATIONS' in validationErrors.fixSources %}
               <li>
                   <p class="govuk-body govuk-!-margin-bottom-0">Update these details in the <a href="{{ manageAdjudicationsUrl }}/adjudication-history/{{ model.prisonerDetail.offenderNo }}">Adjudications tab</a>.
                   </p>
               </li>
          {% endif %}
     {% else %}
        <li>
            <p class="govuk-body govuk-!-margin-bottom-0">Update these details in NOMIS and then <a href="">reload this page</a>.
            </p>
        </li>
     {% endif %}
