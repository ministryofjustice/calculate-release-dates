{% include "./list-validation-messages.njk" %}

     {% if validationErrors.fixSources|length %}
          {% if 'ADJUSTMENTS' in validationErrors.fixSources %}
               <li>
                   <p class="govuk-body govuk-!-margin-bottom-0">Update these details in the <a href="{{ adjustmentsUiUrl }}/{{ model.prisonerDetail.offenderNo }}">Adjustments tab</a>.
                   </p>
               </li>
          {% endif %}

          {% if 'ADJUDICATIONS' in validationErrors.fixSources %}
               <li>
                   <p class="govuk-body govuk-!-margin-bottom-0">Update these details in <a href="{{ manageAdjudicationsUrl }}/adjudication-history/{{ model.prisonerDetail.offenderNo }}">Adjudications</a>.
                   </p>
               </li>
          {% endif %}

          {% if 'COURT_CASES' in validationErrors.fixSources %}
               <li>
                   <p class="govuk-body govuk-!-margin-bottom-0">Update these details in the <a href="{{ remandAndSentencingUrl }}/person/{{ model.prisonerDetail.offenderNo }}">Court cases tab</a>.
                   </p>
               </li>
          {% endif %}

          {% if 'RECALLS' in validationErrors.fixSources %}
               <li>
                   <p class="govuk-body govuk-!-margin-bottom-0">Update these details in the <a href="{{ recallsUrl }}/{{ model.prisonerDetail.offenderNo }}">Recalls tab</a>.
                   </p>
               </li>
          {% endif %}
     {% else %}
        <li>
            <p class="govuk-body govuk-!-margin-bottom-0">Update these details in NOMIS and then <a href="">reload this page</a>.
            </p>
        </li>
     {% endif %}
