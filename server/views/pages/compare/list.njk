{% extends "../../partials/layout.njk" %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "moj/components/pagination/macro.njk" import mojPagination %}

{% from "./list/comparisonListItem.njk" import comparisonListItem %}
{% from "./list/comparisonListItem.njk" import noUserItems %}
{% from "./list/comparisonListItem.njk" import noOtherItems %}

{% set scopeHeading = "Your Comparisons" if scope == "your" else "Other's Comparisons" %}
{% set pageTitle = applicationName + " - Bulk Comparisons - " + scopeHeading %}
{% set pageId = "compare" %}

{% block beforeContent %}
    {{ super() }}
    <nav>
        {{ govukBreadcrumbs({
            items: [
                {
                    text: "Home",
                    href: "/"
                },
                {
                    text: "Bulk Compare",
                    href: "/compare/"
                },
                {
                    text: "List",
                    href: "/compare/list"
                }
            ]
        }) }}
    </nav>
{% endblock %}


{% block javascripts %}
    <script src="/assets/accessible-autocomplete.min.js"></script>
    <script id="autocomplete-script" src="{{ '/assets/js/autoCompletePrisonName.js' | assetMap }}"></script>
{% endblock %}

{% set comparisonsList %}
    <ul class="gem-c-document-list gem-c-document-list--no-underline gem-c-document-list--no-top-border-first-child">
        {% for comparison in comparisons %}
            {{ comparisonListItem(comparison, true) }}
        {% endfor %}
        {% if comparisons.length == 0 %}
            {% if scope == "your" %}
                {{ noUserItems() }}
            {% else %}
                {{ noOtherItems() }}
            {% endif %}
        {% endif %}
     </ul>
{% endset -%}


{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-xl">Bulk Comparisons</h1>

            {{ govukServiceNavigation({
              navigationLabel: "Comparisons",
              navigation: [
                {
                  href: "/compare/list",
                  text: "Your Comparisons",
                  current: scope == "your"
                },
                {
                  href: "/compare/list/others",
                  text: "Other's Comparisons",
                  current: scope == "others"
                }
              ]
            }) }}

            <br/>

            <h3 class="govuk-heading-m">Filter comparisons by prison</h3>
            <div class="govuk-grid-row">

                <form action="" class="form-inline">
                    <div class="govuk-grid-column-two-thirds">
                        {{ govukSelect({
                            id: "prison-name",
                            name: "prisonName",
                            items: prisons
                        }) }}
                    </div>
                    <div class="govuk-grid-column-one-third">
                        <div class="govuk-button-group">
                            {{ govukButton({
                              text: "Filter",
                              classes: "govuk-button--primary"
                            }) }}
                             <a href="{{ '/compare/list' if scope == 'your' else '/compare/list/others' }}" type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Clear</a>
                        </div>
                    </div>
                </form>
            </div>

            <h2 class="govuk-heading-l">{{ scopeHeading }}</h2>
            {{ comparisonsList | safe }}

            {{ mojPagination(pagination) }}
        </div>
    </div>
{% endblock %}
